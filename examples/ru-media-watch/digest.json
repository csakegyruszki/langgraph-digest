{
  "_comment": "EXAMPLE config (the only Russia-specific file in this repository). Measured/described in README. 'digest' = what to write; 'settings' = collector behaviour; 'themes' = keyword dictionaries used to tag items; 'sources' = feeds. To add a source: one new object in 'sources'. method='rss' (urls + optional telegram fallback) or method='telegram'. State paths are relative to DATA_DIR. Source status: see sources.md (verified 2026-06-23).",
  "digest": {
    "title": "RU Media Watch",
    "slug": "ru-media-watch",
    "language": "English",
    "audience": "an analyst who does not read Russian and wants a complete English overview of what is happening in Russian-language independent media that could matter to an investigative journalist",
    "beat": "Russian intelligence and security services, covert operations and sabotage abroad, espionage and agent-network cases (including those tried in European courts), assassinations and poisonings, influence and disinformation operations against Europe, sanctions evasion and the shadow fleet, kleptocracy and elite-corruption networks, private military companies, surveillance and digital-control technology. This is the Russia-side view from Russian-language media, not the domestic news of any single country outside Russia; do not chase a country-specific angle for its own sake. Items carrying the theme `covert_ops` (sabotage, espionage, assassination, shadow fleet, PMC, cyber) are on the beat axis.",
    "focus_count": 3,
    "priority_keywords": [],
    "sections": [
      {
        "name": "In focus — read in full",
        "focus": true,
        "instruction": "the deep reads (tags, clean source link, a summary of 4–5 SHORT sentences, tight, no long compound sentences: actors, the key number or method, why it matters, source type: reporting, document leak, court case, intelligence assessment, inference)."
      },
      {
        "name": "Most relevant to the beat",
        "instruction": "5–8 further beat-relevant items, each a rich 2–3 sentence summary (what happened + one analytical \"so what\"), tags, clean source link. Merge duplicate coverage of one event into a single entry citing the best 2–3 sources."
      },
      {
        "name": "Covert hand abroad — intelligence and influence operations",
        "instruction": "surface EVERY item tagged `covert_ops` that is not already covered above (sabotage, espionage and agent cases including in European courts, assassinations, recruitment, shadow fleet, PMCs, cyber) — one to two sentences each plus link, even short wire stories. This is a priority section; do not let these slip just because they are small."
      },
      {
        "name": "Also trending",
        "instruction": "a final CATCH-ALL. A compact bulleted list (one line + link each) of everything else getting attention in the Russian-language press this window that did not fit above: war and economy, repression cases, society, etc. Group loosely by theme if long."
      }
    ]
  },
  "settings": {
    "accept_language": "ru-RU,ru;q=0.9,en-US;q=0.8,en;q=0.7",
    "lookback_days": 4,
    "max_items_per_source": 25,
    "request_timeout": 12,
    "inbox_dir": "inbox",
    "archive_dir": "archive",
    "digests_dir": "digests",
    "seen_path": "seen_urls.json",
    "log_path": "monitor.log",
    "theme_filter_sources": [
      "meduza",
      "mediazona",
      "theinsider",
      "novaya_europe",
      "moscowtimes",
      "currenttime",
      "astra",
      "sirena",
      "tvrain",
      "echofm",
      "zerkalo"
    ],
    "_theme_filter_note": "For these high-volume daily-news / breaking desks only theme-matching / priority items are kept (noise filter). Purely investigative outlets keep everything; final curation is done by the digest model."
  },
