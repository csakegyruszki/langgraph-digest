# Names only, values intentionally empty. Copy to .env (gitignored) or pass --env-file PATH.
# Existing process environment variables always win over file values.

# LLM (OpenAI-compatible chat/completions endpoint)
# LLM_API_KEY_VAR names the variable that holds the key (default set by the graph: OPENROUTER_API_KEY).
LLM_API_KEY_VAR=OPENROUTER_API_KEY
OPENROUTER_API_KEY=
LLM_BASE_URL=
DEEPSEEK_MODEL=

# E-mail (only used with --send-email)
RESEND_API_KEY=
DIGEST_TO=
RESEND_FROM=

# Langfuse tracing (optional; enabled only if both keys are set)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Digest config (JSON); default examples/tech-news/digest.json, or pass --config
DIGEST_CONFIG=

# Working data: inbox/, digests/, seen_urls.json, monitor.log (default ./data)
DATA_DIR=

# Optional: time zone for the digest date, e.g. Europe/London (default UTC)
DIGEST_TZ=
